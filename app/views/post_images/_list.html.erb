<% post_images.each do |post_image| %>
<div>
  <%= link_to post_image_path(post_image.id) do %>
    <%= image_tag post_image.get_image %> <%# PostImageモデルに記述したget_imageメソッド 画像がなかったら〜、、 %>
  <% end %>
  <p>投稿ユーザー画像：<%= image_tag post_image.user.get_profile_image(100,100) %></p>
  <p>ショップ名：<%= post_image.shop_name %></p>  <%# PostImageモデルで定義されたカラム %>
  <p>説明： <%= post_image.caption %></p>  <%# PostImageモデルで定義されたカラム %>
  <p>ユーザーネーム：<%= post_image.user.name %></p> <%# PostImageモデルで定義されたカラムuser_idにリレーションされたnameを表示 %>
  <p><%= link_to "#{post_image.post_comments.count} コメント", post_image_path(post_image.id) %></p>
</div>
<% end %>
<%= paginate post_images %>